# ===========================================================================
# Multilingual file for the TOS 7 Docker application "calibrewebdocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "Calibre-Web"
auth         = "janeczku"
version      = "@@VERSION@@"
descript     = "Calibre-Web is a web app for browsing, reading and downloading eBooks from an existing Calibre library. Search by author, series, tag or language, read EPUB/PDF in the browser or send books to an e-reader. Runs as a non-root container; the library and settings stay in the app data folder."
release_note = "1. First release: Calibre-Web 0.6.27 from Docker Hub, running as a non-root container. The Calibre library and settings live in the application data folder and survive restarts and updates."
important    = "Login: admin / admin123 - change it now. Needs DockerEngine. Put the Calibre library (folder with metadata.db) in DockerAppData/calibrewebdocker/books via SSH/SFTP, then set /books in the UI. Back up that folder before uninstalling with data removal. Plain HTTP on the LAN."

[zh-cn]
name         = "Calibre-Web"
auth         = "janeczku"
version      = "@@VERSION@@"
descript     = "Calibre-Web 是一个基于现有 Calibre 书库的电子书 Web 应用。它让局域网内的所有人都能用浏览器浏览、搜索和阅读电子书：按作者、系列、标签或语言筛选，在线阅读 EPUB/PDF 或推送到阅读器，也可以在授权后编辑元数据、上传新书。本应用使用 Docker Hub 官方镜像并以非 root 用户运行；书库与全部设置都保存在应用数据目录，重启和升级都不会丢失。"
release_note = "1. 首个版本：Calibre-Web 0.6.27，来自 Docker Hub，以非 root 用户运行。书库与设置保存在应用数据目录，重启和升级不丢失。"
important    = "初始账号 admin，密码 admin123，请立即修改。需要 DockerEngine。请把 Calibre 书库（含 metadata.db 的文件夹）通过 SSH/SFTP 放到 DockerAppData/calibrewebdocker/books（文件管理器看不到该目录），然后在网页里把书库路径设为 /books。卸载并删除数据前请备份该目录。应用通过局域网 HTTP 访问。"

[zh-hk]
name         = "Calibre-Web"
auth         = "janeczku"
version      = "@@VERSION@@"
descript     = "Calibre-Web 是一個以現有 Calibre 書庫為基礎的電子書 Web 應用。它讓局域網內所有人用瀏覽器瀏覽、搜尋和閱讀電子書：按作者、系列、標籤或語言篩選，在線閱讀 EPUB/PDF 或推送到閱讀器，也可在授權後編輯元資料、上傳新書。本應用使用 Docker Hub 官方鏡像並以非 root 使用者運行；書庫與全部設定都保存在應用資料目錄，重啟和升級都不會遺失。"
release_note = "1. 首個版本：Calibre-Web 0.6.27，來自 Docker Hub，以非 root 使用者運行。書庫與設定保存在應用資料目錄，重啟和升級不遺失。"
important    = "初始帳號 admin，密碼 admin123，請立即修改。需要 DockerEngine。請把 Calibre 書庫（含 metadata.db 的資料夾）透過 SSH/SFTP 放到 DockerAppData/calibrewebdocker/books（檔案管理員看不到該目錄），然後在網頁把書庫路徑設為 /books。解除安裝並刪除資料前請備份該目錄。應用透過局域網 HTTP 存取。"

